{
  "id": "rtc_hellgenie_engine",
  "name": "RTC Hellgenie Engine",
  "description": "Ported from RTCV's real RTC_HellgenieEngine.GenerateUnit: the simplest of the ported engines \u2014 every blast writes a brand-new random value within the chosen bit-width's Min/Max bounds at an aligned address. No Algo choice, no tilt, just a straight random SET. Its own address-clamp formula is copied directly from that source.",
  "author": "Ported from RTCV (RTC_HellgenieEngine.cs) for RTCFS4A",
  "version": "1.0",
  "parameters": [
    {
      "id": "precision",
      "label": "Precision (bytes)",
      "type": "dropdown",
      "options": [
        "1",
        "2",
        "4",
        "8"
      ],
      "default": "4",
      "description": "Size of each write: 1 = 8-bit, 2 = 16-bit, 4 = 32-bit, 8 = 64-bit."
    },
    {
      "id": "min8",
      "label": "Min Value (8-bit)",
      "type": "number",
      "min": 0,
      "max": 255,
      "step": 1,
      "default": "0",
      "visibleWhenParam": "precision",
      "visibleWhenValues": [
        "1"
      ]
    },
    {
      "id": "max8",
      "label": "Max Value (8-bit)",
      "type": "number",
      "min": 0,
      "max": 255,
      "step": 1,
      "default": "255",
      "visibleWhenParam": "precision",
      "visibleWhenValues": [
        "1"
      ]
    },
    {
      "id": "min16",
      "label": "Min Value (16-bit)",
      "type": "number",
      "min": 0,
      "max": 65535,
      "step": 1,
      "default": "0",
      "visibleWhenParam": "precision",
      "visibleWhenValues": [
        "2"
      ]
    },
    {
      "id": "max16",
      "label": "Max Value (16-bit)",
      "type": "number",
      "min": 0,
      "max": 65535,
      "step": 1,
      "default": "65535",
      "visibleWhenParam": "precision",
      "visibleWhenValues": [
        "2"
      ]
    },
    {
      "id": "min32",
      "label": "Min Value (32-bit)",
      "type": "number",
      "min": 0,
      "max": 4294967295,
      "step": 1,
      "default": "0",
      "visibleWhenParam": "precision",
      "visibleWhenValues": [
        "4"
      ]
    },
    {
      "id": "max32",
      "label": "Max Value (32-bit)",
      "type": "number",
      "min": 0,
      "max": 4294967295,
      "step": 1,
      "default": "4294967295",
      "visibleWhenParam": "precision",
      "visibleWhenValues": [
        "4"
      ]
    },
    {
      "id": "min64",
      "label": "Min Value (64-bit)",
      "type": "number",
      "min": 0,
      "max": 18446744073709551615,
      "step": 1,
      "default": "0",
      "description": "Very large 64-bit bounds may lose a little precision if you edit them by hand \u2014 the default full range is exact until you touch it.",
      "visibleWhenParam": "precision",
      "visibleWhenValues": [
        "8"
      ]
    },
    {
      "id": "max64",
      "label": "Max Value (64-bit)",
      "type": "number",
      "min": 0,
      "max": 18446744073709551615,
      "step": 1,
      "default": "18446744073709551615",
      "description": "Same precision caveat as Min Value (64-bit) above.",
      "visibleWhenParam": "precision",
      "visibleWhenValues": [
        "8"
      ]
    },
    {
      "id": "iterations",
      "label": "Blast Count",
      "type": "slider",
      "min": 1,
      "max": 1000000,
      "step": 1,
      "default": "200",
      "unit": " blasts",
      "description": "How many random writes to perform. Use the number box next to the slider for exact values."
    },
    {
      "id": "alignment",
      "label": "Alignment",
      "type": "number",
      "min": 0,
      "max": 1000000,
      "step": 1,
      "default": "0",
      "description": "Sub-offset added after rounding down to Precision: safeAddress = address - (address % precision) + alignment."
    },
    {
      "id": "rangeStart",
      "label": "Start Byte",
      "type": "number",
      "min": -1,
      "max": 100000000,
      "step": 1,
      "default": "-1",
      "description": "-1 = auto (right after Header Size below)."
    },
    {
      "id": "rangeEnd",
      "label": "End Byte",
      "type": "number",
      "min": -1,
      "max": 100000000,
      "step": 1,
      "default": "-1",
      "description": "-1 = auto (end of file)."
    },
    {
      "id": "headerSize",
      "label": "Header Size",
      "type": "number",
      "min": 0,
      "max": 100000,
      "step": 1,
      "default": "16",
      "unit": "bytes",
      "description": "Bytes to leave alone at the start of the file when Start Byte is -1. 16 for .nes/.fds, 512 for headered .smc, 0 for a headerless ROM."
    },
    {
      "id": "bigEndian",
      "label": "Big Endian",
      "type": "switch",
      "default": "false",
      "description": "Byte order for each write."
    },
    {
      "id": "seed",
      "label": "Seed",
      "type": "number",
      "min": -1,
      "max": 999999999,
      "step": 1,
      "default": "-1",
      "description": "-1 = random (a fresh seed every run, still recorded into this field on Save so Export Config can reproduce it later). Any value 0 or above is used as a fixed seed instead."
    },
    {
      "id": "lastSeedUsed",
      "label": "Last Seed Used",
      "type": "number",
      "min": -1,
      "max": 999999999,
      "step": 1,
      "default": "-1",
      "hidden": true,
      "description": "Internal bookkeeping: the actual seed the most recent run used, recorded here (not in Seed itself) so Export Config can reproduce it without flipping Seed out of auto mode."
    }
  ],
  "operations": [
    {
      "type": "hellgenie_engine",
      "params": {
        "precision": "precision",
        "alignment": "alignment",
        "iterations": "iterations",
        "rangeStart": "rangeStart",
        "rangeEnd": "rangeEnd",
        "headerSize": "headerSize",
        "bigEndian": "bigEndian",
        "min8": "min8",
        "max8": "max8",
        "min16": "min16",
        "max16": "max16",
        "min32": "min32",
        "max32": "max32",
        "min64": "min64",
        "max64": "max64"
      }
    }
  ]
}
