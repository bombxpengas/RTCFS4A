{
  "id": "classic_duplicate_block",
  "name": "Duplicate Block",
  "description": "Copies one chunk over other chunks — repeating/echo glitch pattern.",
  "author": "File Corruptor",
  "version": "1.0",
  "parameters": [
    {
      "id": "intensity",
      "label": "Intensity",
      "type": "slider",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": "20",
      "unit": "%",
      "description": "Percentage of chunks that get overwritten with a copy of one source chunk."
    },
    {
      "id": "chunkSize",
      "label": "Chunk Size",
      "type": "number",
      "min": 16,
      "max": 65536,
      "step": 16,
      "default": "256",
      "unit": "bytes"
    },
    {
      "id": "skipBytes",
      "label": "Preserve Header (bytes)",
      "type": "number",
      "min": 0,
      "max": 100000,
      "step": 1,
      "default": "128",
      "unit": "bytes"
    }
  ],
  "operations": [
    {
      "type": "duplicate_block",
      "params": { "intensity": "intensity", "skipBytes": "skipBytes", "chunkSize": "chunkSize" }
    }
  ]
}
