{
  "id": "classic_zero_out",
  "name": "Zero Out",
  "description": "Replaces random bytes with 0x00 — creates dropout / missing-block glitches.",
  "author": "File Corruptor",
  "version": "1.0",
  "parameters": [
    {
      "id": "intensity",
      "label": "Intensity",
      "type": "slider",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": "15",
      "unit": "%"
    },
    {
      "id": "skipBytes",
      "label": "Preserve Header (bytes)",
      "type": "number",
      "min": 0,
      "max": 100000,
      "step": 1,
      "default": "128",
      "unit": "bytes"
    }
  ],
  "operations": [
    {
      "type": "zero_out",
      "params": { "intensity": "intensity", "skipBytes": "skipBytes" }
    }
  ]
}
